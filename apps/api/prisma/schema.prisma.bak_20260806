generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id              String            @id @default(cuid())
  name            String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  users           User[]
  bots            Bot[]
  customers       Customer[]
  conversations   Conversation[]
  leads           Lead[]
  knowledge       Knowledge[]
  channelMessages ChannelMessage[]
  channelStats    ChannelStat[]
  salesMemories   SalesMemory[]
  customerIdentities CustomerIdentity[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
}

model Bot {
  id          String    @id @default(cuid())
  name        String
  description String?
  model       String    @default("deepseek-chat")
  systemPrompt String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  conversations Conversation[]
  knowledge   Knowledge[]
}

model Customer {
  id          String            @id @default(cuid())
  name        String
  email       String?
  phone       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  identities  CustomerIdentity[]
  conversations Conversation[]
  salesMemories SalesMemory[]
  leads       Lead[]
}

model CustomerIdentity {
  id          String   @id @default(cuid())
  platform    String
  platformId  String
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([platform, platformId, tenantId])
}

model Conversation {
  id          String      @id @default(cuid())
  channel     String
  channelId   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  customerId  String?
  customer    Customer?   @relation(fields: [customerId], references: [id])
  botId       String
  bot         Bot         @relation(fields: [botId], references: [id])
  messages    Message[]
}

model Message {
  id            String      @id @default(cuid())
  content       String
  sender        String      // "customer" or "bot"
  direction     String      // "inbound" or "outbound"
  createdAt     DateTime    @default(now())
  conversationId String
  conversation  Conversation @relation(fields: [conversationId], references: [id])
  metadata      Json?
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
}

model ChannelMessage {
  id            String      @id @default(cuid())
  channel       String
  externalUserId String
  content       String
  direction     String      // "inbound" or "outbound"
  createdAt     DateTime    @default(now())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id])
  conversationId String?
  conversation  Conversation? @relation(fields: [conversationId], references: [id])
  metadata      Json?
}

model ChannelStat {
  id            String   @id @default(cuid())
  date          DateTime
  channel       String
  customerCount Int      @default(0)
  messageCount  Int      @default(0)
  conversionCount Int    @default(0)
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, date, channel])
}

model Knowledge {
  id        String   @id @default(cuid())
  title     String
  content   String
  type      String
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  channels  KnowledgeChannel[]
  embeddings KnowledgeEmbedding[]
}

model KnowledgeChannel {
  id          String   @id @default(cuid())
  knowledgeId String
  knowledge   Knowledge @relation(fields: [knowledgeId], references: [id])
  channel     String
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([knowledgeId, channel])
}

model KnowledgeEmbedding {
  id          String   @id @default(cuid())
  knowledgeId String   @unique
  knowledge   Knowledge @relation(fields: [knowledgeId], references: [id])
  embedding   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Lead {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String?
  status      String   @default("new")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  scoreHistory LeadScoreHistory[]
}

model LeadScoreHistory {
  id        String   @id @default(cuid())
  score     Int
  reason    String
  metadata  Json?
  createdAt DateTime @default(now())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
}

model SalesMemory {
  id         String   @id @default(cuid())
  type       String
  content    Json
  createdAt  DateTime @default(now())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
}
