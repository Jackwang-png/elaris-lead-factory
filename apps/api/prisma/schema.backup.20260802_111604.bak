generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanType {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model Plan {
  id           String         @id @default(cuid())
  name         String         @unique
  dailyLimit   Int
  price        Float
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  Subscription Subscription[]
  Usage        Usage[]
}

model Tenant {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bots          Bot[]
  customers     Customer[]
  conversations Conversation[]
  knowledge     Knowledge[]
  leads         Lead[]
  subscriptions Subscription[]
  usages        Usage[]
  users         User[]
}

model Subscription {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  plan      Plan               @relation(fields: [planId], references: [id])
  status    SubscriptionStatus
  startAt   DateTime
  expireAt  DateTime
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  planId    String
}

model Usage {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  date         DateTime
  messageCount Int      @default(0)
  tokenUsage   Int      @default(0)
  planId       String?
  plan         Plan?    @relation(fields: [planId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, date])
}

model Bot {
  id             String           @id @default(cuid())
  name           String
  description    String?
  model          String           @default("deepseek-chat")
  systemPrompt   String?
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  knowledge      Knowledge[]
  conversations  Conversation[]
  leads          Lead[]
  salesRules     SalesRule[]
  CustomerMemory CustomerMemory[]
}

model Knowledge {
  id        String   @id @default(cuid())
  title     String
  content   String
  botId     String
  bot       Bot      @relation(fields: [botId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  tenantId  String?
}

model Conversation {
  id        String    @id @default(cuid())
  botId     String
  bot       Bot       @relation(fields: [botId], references: [id])
  visitor   String    @default("api-user")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
  leads     Lead[]
  Tenant    Tenant?   @relation(fields: [tenantId], references: [id])
  tenantId  String?
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  role           String
  content        String
  createdAt      DateTime     @default(now())
}

model Lead {
  id                 String        @id @default(cuid())
  tenantId           String
  tenant             Tenant        @relation(fields: [tenantId], references: [id])
  botId              String
  bot                Bot           @relation(fields: [botId], references: [id])
  conversationId     String?
  conversation       Conversation? @relation(fields: [conversationId], references: [id])
  name               String?
  company            String?
  industry           String?
  platform           String?
  phone              String?
  wechat             String?
  email              String?
  interests          String[]      @default([])
  preferences        Json?         @default("{}")
  purchaseHistory    Json?         @default("[]")
  tags               String[]      @default([])
  buyingStage        String?
  interestedProduct  String?
  budget             String?
  urgency            String?
  highPurchaseIntent Boolean?      @default(false)
  source             String        @default("ai")
  intentScore        Int?
  intentLevel        String?
  status             String        @default("new")
  salesStatus        String        @default("new")
  followCount        Int           @default(0)
  content            String?
  remark             String?
  lastContactAt      DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String   @unique
  password  String
  firstName String?
  lastName  String?
  avatarUrl String?
  isActive  Boolean  @default(true)
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CustomerMemory {
  id              String    @id @default(cuid())
  botId           String
  bot             Bot       @relation(fields: [botId], references: [id])
  customerId      String
  name            String?
  phone           String?
  wechat          String?
  email           String?
  interests       String[]  @default([])
  preferences     Json?     @default("{}")
  purchaseHistory Json?     @default("[]")
  tags            String[]  @default([])
  intentScore     Int?
  intentLevel     String?
  lastContactAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([botId, customerId])
}

model SalesRule {
  id        String   @id @default(cuid())
  botId     String
  bot       Bot      @relation(fields: [botId], references: [id])
  name      String
  content   String
  type      String   @default("script")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name  String?
  email String?
  phone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Agent {
  id        String @id @default(cuid())
  tenantId  String
  botId     String?

  name      String
  type      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model AgentExecution {
  id String @id @default(cuid())

  agentId String

  status String @default("running")

  input Json?
  output Json?

  createdAt DateTime @default(now())
}


model AgentMemory {
  id String @id @default(cuid())

  agentId String

  key String
  value Json

  createdAt DateTime @default(now())

  @@unique([agentId,key])
}


model CustomerProfile {
  id String @id @default(cuid())

  tenantId String
  customerId String

  industry String?
  platform String?

  preferences Json?
  purchaseHistory Json?

  remark String?

  createdAt DateTime @default(now())

  @@unique([tenantId,customerId])
}


model SalesWorkflow {
  id String @id @default(cuid())

  tenantId String

  name String

  steps Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model SalesTask {
  id String @id @default(cuid())

  tenantId String

  title String

  status String @default("pending")

  payload Json?

  createdAt DateTime @default(now())
}
