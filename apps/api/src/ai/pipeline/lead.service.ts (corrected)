import { Injectable } from '@nestjs/common';
import OpenAI from 'openai';
import { PrismaService } from '../../prisma/prisma.service';
import { IntentService } from './intent.service';

@Injectable()
export class LeadService {
  private client: OpenAI;

  constructor(
    private prisma: PrismaService,
    private intentService: IntentService
  ) {
    this.client = new OpenAI({
      apiKey: process.env.OPENAI_API_KEY,
      baseURL: process.env.OPENAI_BASE_URL,
    });
  }

  async saveLead(
    bot: any,
    conversationId: string,
    message: string,
    answer: string
  ) {
    // Quick check: if message contains no buying-related keywords, skip lead creation
    const quickWords = [
      '购买', '价格', '多少钱', '联系', '体验',
      '合作', '报价', '方案', '下单', '订购',
      '询价', '预算', 'demo', 'trial', '试用',
      '演示', '签约', '合同', '付款', '支付',
      '发票', '订单', '买', '微信'
    ];

    const hasQuickMatch = quickWords.some(w => message.includes(w));
    if (!hasQuickMatch) {
      return;
    }

    // Extract customer info (existing logic)
    const extract = await this.client.chat.completions.create({
      model: bot.model,
      messages: [
        {
          role: 'system',
          content: `你是销售线索提取助手。

只返回JSON。

格式:

{
"name":"",
"company":"",
"industry":"",
"platform":"",
"phone":"",
"wechat":"",
"email":""
}

没有的信息返回空字符串。`
        },
        {
          role: 'user',
          content: message
        }
      ]
    });

    let customerInfo: any = {};
    try {
      customerInfo = JSON.parse(extract.choices[0].message.content || '{}');
    } catch (e) {
      customerInfo = {};
    }

    // Detect buying intent
    const intent = await this.intentService.detectBuyingIntent(message);

    let existingLead: any = null;

    // 1. Company match
    if (customerInfo.company) {
      existingLead = await this.prisma.lead.findFirst({
        where: {
          tenantId: bot.tenantId,
          botId: bot.id,
          company: customerInfo.company
        }
      });
    }

    // 2. WeChat match
    if (!existingLead && customerInfo.wechat) {
      existingLead = await this.prisma.lead.findFirst({
        where: {
          tenantId: bot.tenantId,
          botId: bot.id,
          wechat: customerInfo.wechat
        }
      });
    }

    const newContent = `--- 客户消息 ---
${message}

--- AI回复 ---
${answer}
`;

    if (existingLead) {
      await this.prisma.lead.update({
        where: { id: existingLead.id },
        data: {
          conversationId: conversationId,
          name: customerInfo.name || existingLead.name,
          industry: customerInfo.industry || existingLead.industry,
          platform: customerInfo.platform || existingLead.platform,
          phone: customerInfo.phone || existingLead.phone,
          wechat: customerInfo.wechat || existingLead.wechat,
          email: customerInfo.email || existingLead.email,
          intentScore: intent.score,
          intentLevel: intent.level,
          status: intent.level,
          content: (existingLead.content || '') + '\n\n' + newContent,
          lastContactAt: new Date()
        }
      });
    } else {
      await this.prisma.lead.create({
        data: {
          tenantId: bot.tenantId,
          botId: bot.id,
          conversationId: conversationId,
          name: customerInfo.name || null,
          company: customerInfo.company || null,
          industry: customerInfo.industry || null,
          platform: customerInfo.platform || null,
          phone: customerInfo.phone || null,
          wechat: customerInfo.wechat || null,
          email: customerInfo.email || null,
          source: 'ai',
          intentScore: intent.score,
          intentLevel: intent.level,
          status: intent.level,
          salesStatus: 'new',
          followCount: 0,
          content: newContent,
          lastContactAt: new Date()
        }
      });
    }
  }
}
